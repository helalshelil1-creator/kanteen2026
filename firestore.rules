rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ═══ HELPERS ═══
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin';
    }
    
    function onlyFieldsChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ═══ ADMINS ═══
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // ═══ USERS ═══
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid
        && onlyFieldsChanged(['name','phone','photoURL','updatedAt','fcmToken','preferences','defaultAddress']);
      allow delete: if isAdmin();
    }

    // ═══ MERCHANTS ═══
    match /merchants/{merchantId} {
      allow read: if true;
      
      // ✅ Admin يقدر يضيف تاجر مباشرة
      allow create: if isAdmin()
        || (isSignedIn()
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.status == 'pending');
      
      // ✅ Admin + المالك
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.ownerUid == request.auth.uid
            && onlyFieldsChanged(['name','address','phone','whatsapp','lat','lng',
                                  'products','hours','description','photoURL',
                                  'updatedAt','category','deliveryFee']));
      
      allow delete: if isAdmin();
    }

    // ═══ ORDERS ═══
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.customerUid == request.auth.uid)
        || (isSignedIn() && resource.data.driverId == request.auth.uid)
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      
      allow create: if isSignedIn()
        && request.resource.data.customerUid == request.auth.uid;
      
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.driverId == request.auth.uid
            && onlyFieldsChanged(['status','pickedAt','deliveredAt','acceptedAt',
                                  'driverLat','driverLng','driverNotes','cancellationReason',
                                  'statusHistory','paymentStatus']))
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid
            && onlyFieldsChanged(['status','confirmedAt','preparingAt','merchantNotes',
                                  'statusHistory']))
        || (isSignedIn() && resource.data.customerUid == request.auth.uid
            && onlyFieldsChanged(['status','cancelledAt','cancellationReason','statusHistory']));
      
      allow delete: if isAdmin();

      match /chat/{messageId} {
        allow read, create: if isAdmin()
          || (isSignedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == request.auth.uid)
          || (isSignedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.driverId == request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }

    // ═══ DRIVERS ═══
    match /drivers/{driverId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && request.auth.uid == driverId
        && request.resource.data.status == 'pending';
      
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == driverId
            && onlyFieldsChanged(['name','phone','whatsapp','email','vehicle','area',
                                  'online','lat','lng','lastSeen','fcmToken',
                                  'profilePhoto','idCardFront','idCardBack',
                                  'locationAddress','updatedAt']));
      
      allow delete: if isAdmin();
    }

    // ═══ NOTIFICATIONS ═══
    match /notifications/{notifId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ═══ RATINGS ═══
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.customerUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ═══ COUPONS ═══
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ═══ CONFIG ═══
    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ═══ FCM TOKENS ═══
    match /fcmTokens/{token} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ═══ TEST ═══
    match /_test/{doc} {
      allow read, write: if false;
    }
  }
}